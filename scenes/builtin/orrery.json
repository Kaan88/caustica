   "script": "let planets = [[1, 1.0000, 0.5000, 1.6000], [3, 1.5000, 2.9000, 0.8710], [5, 2.1000, -0.9832, 0.5257], [7, 2.7000, 1.4168, 0.3606], [9, 3.6000, -2.4664, 0.2342], [11, 4.6000, -0.0664, 0.1622], [13, 4.6000, -0.0664, 0.1622], [14, 5.4000, 2.3336, 0.1275], [16, 6.1000, -1.5495, 0.1062]];\nfor p in planets {\n    let a = p[2] + p[3] * t;\n    set(`objects/${p[0]}/position/0`, p[1] * a.cos());\n    set(`objects/${p[0]}/position/1`, p[1] * a.sin());\n}\n"
