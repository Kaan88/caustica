float GGX_ALBEDO_at(uint i) { return GGX_ALBEDO[i >> 2][i & 3]; }
float ggx_albedo(float nv, float roughness) {
    float2 x = saturate(float2(nv, roughness)) * 31;
    uint2 i = min(uint2(x), 30); float2 f = x - i;
    #define S(c, r) GGX_ALBEDO_at((i.y + r) * 32 + i.x + c)
    float e = lerp(lerp(S(0, 0), S(1, 0), f.x), lerp(S(0, 1), S(1, 1), f.x), f.y);
    #undef S
    return e;
}
