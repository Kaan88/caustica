float ANISO_ALBEDO_at(uint i) { return ANISO_ALBEDO[i >> 2][i & 3]; }
float aniso_albedo(float nv, float azimuth, float roughness, float strength) {
    float4 x = saturate(float4(nv, azimuth, roughness, strength)) * float4(11, 3, 7, 5);
    uint4 i = min(uint4(x), uint4(10, 2, 6, 4)); float4 f = x - i;
    float e = 0;
    [unroll] for (uint k = 0; k < 16; k++) {
        uint4 c = uint4(k & 1, (k >> 1) & 1, (k >> 2) & 1, k >> 3);
        float4 w = lerp(1 - f, f, float4(c));
        uint4 j = i + c; e += w.x * w.y * w.z * w.w * ANISO_ALBEDO_at(((j.w * 8 + j.z) * 4 + j.y) * 12 + j.x);
    }
    return e;
}
