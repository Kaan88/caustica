float SHEEN_ALBEDO_at(uint i) { return SHEEN_ALBEDO[i >> 2][i & 3]; }
static const float SHEEN_MIN_ROUGHNESS = 0.07;
float sheen_albedo(float nv, float roughness) {
    float2 x = saturate(float2(nv, roughness)) * 15;
    uint2 i = min(uint2(x), 14); float2 f = x - i;
    #define S(c, r) SHEEN_ALBEDO_at((i.y + r) * 16 + i.x + c)
    float e = lerp(lerp(S(0, 0), S(1, 0), f.x), lerp(S(0, 1), S(1, 1), f.x), f.y);
    #undef S
    return e;
}
